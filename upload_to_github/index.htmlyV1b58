                <text x="760" y="418" text-anchor="middle" font-size="13" fill="#d9b96a"
                    font-family="Songti TC, serif" letter-spacing="1">1992 ARCHIVE</text>
                <rect x="700" y="378" width="120" height="6" rx="2" fill="#2c3650"/>
