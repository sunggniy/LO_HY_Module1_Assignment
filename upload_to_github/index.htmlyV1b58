<div class="app">
    <aside class="col-filters">
        <div class="brand">
            <div class="brand-tag">Field Photo Archive · 1992</div>
            <h1>B09 照片地圖</h1>
            <div class="sub">馬灣涌 (Ma Wan Chung) · 張振江、顏孔昭 攝</div>
        </div>
        <div class="count-box">
            <span class="c-lbl">目前顯示記錄</span>
            <span><b id="count">–</b><span class="c-sep">/</span><span id="total">–</span></span>
        </div>
        <div class="search-box"><input id="search" type="search" placeholder="搜尋內容／地點／編號…" autocomplete="off"></div>
        <div class="tagline">Use the filters to compare what was photographed, where, and with what degree of spatial certainty.</div>
        <div class="legend">
            <span><i style="background:#33a02c"></i>Exact</span>
            <span><i style="background:#fff400"></i>Approximate</span>
            <span><i style="background:#fb9a99"></i>Village-level</span>
        </div>
        <div class="quick-actions">
            <button id="btnUncertain">Show uncertain locations</button>
            <button id="btnReset">Reset</button>
        </div>
        <div id="quickNote"></div>
        <div id="filter-root"></div>
        <div class="legend-note">地圖可於右上角面板一鍵開關 1963 年航照（四幅合併）與現今地形圖（東西幅合併）。點選 marker 後於右側顯示照片與資料；點數字聚類圓可展開同點照片。</div>
    </aside>
    <main class="col-map"><div id="map"></div><div id="filmstrip"></div>
        <div id="mapHint">在地圖上<b>點選聚類圓或照片</b>，展開 1992 年的馬灣涌檔案 →</div>
        <a id="backHome" title="返回田野工作台">⌂</a></main>
    <aside class="col-detail" id="detail">
        <div class="detail-empty">← 在地圖上點選聚類圓或照片 marker<br>照片檔案會在此展開</div>
    </aside>
</div>

<script src="js/leaflet.js"></script>
<script src="js/leaflet.markercluster.js"></script>
<script src="js/Autolinker.min.js"></script>
<script>
(function () {
    'use strict';

    // ---------- 0. CSV 來源（相對路徑，直接讀原始檔，不另存副本） ----------
    // 候選路徑：伺服器根目錄不同時自動嘗試（本頁位於 module1/photos/<匯出夾>/ 之下）
    var CSV_CANDIDATES = ['../../individualphoto(B09).csv', '../../../individualphoto(B09).csv'];

    // ---------- 1. Raster（沿用原匯出之圖幅與 bounds） ----------
    var RASTERS = [
        { name: '1963年航照（西北幅）', url: 'data/1963map2_2.png', bounds: [[22.28449393403416,113.92682402458401],[22.289923306442734,113.93411125972408]] },
        { name: '1963年航照（東北幅）', url: 'data/1963map1_5.png', bounds: [[22.2845049777764,113.93410190516055],[22.289934026843603,113.94138886434231]] },
        { name: '1963年航照（西南幅）', url: 'data/1963map4_3.png', bounds: [[22.279075604744705,113.92683365962723],[22.2845049777764,113.934120611394]] },
        { name: '1963年航照（東南幅）', url: 'data/1963map3_4.png', bounds: [[22.27908664550362,113.93411125972408],[22.284515695281364,113.94139793561807]] },
        { name: '現今地形圖（西幅）',   url: 'data/2_0.png',       bounds: [[22.273607952312364,113.89769308407159],[22.300758044667496,113.93413201704129]] },
        { name: '現今地形圖（東幅）',   url: 'data/1_1.png',       bounds: [[22.273666401328807,113.93408524462212],[22.300808410150857,113.9705172786357]] }
    ];

    // ---------- 2. 小型 CSV 解析器（支援引號與逗號） ----------
    function parseCSV(text) {
        var rows = [], row = [], cur = '', inQ = false, i, c;
        for (i = 0; i < text.length; i++) {
            c = text[i];
            if (inQ) {
                if (c === '"') {
                    if (text[i + 1] === '"') { cur += '"'; i++; }
                    else { inQ = false; }
                } else { cur += c; }
            } else {
                if (c === '"') { inQ = true; }
                else if (c === ',') { row.push(cur); cur = ''; }
                else if (c === '\n') { row.push(cur); rows.push(row); row = []; cur = ''; }
                else if (c !== '\r') { cur += c; }
            }
        }
        if (cur !== '' || row.length) { row.push(cur); rows.push(row); }
        if (!rows.length) return [];
        while (rows.length && rows[0].length === 1 && rows[0][0] === '') rows.shift();  // 跳過開頭空行（內嵌區塊標籤後的換行）
        var head = rows[0];
        return rows.slice(1).filter(function (r) { return r.length > 1 && r[0] !== ''; })
            .map(function (r) {
                var o = {};
                head.forEach(function (h, idx) { o[h.trim()] = (r[idx] || '').trim(); });
                return o;
            });
    }

    function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function fileName(rec) {
        var p = (rec['Photo_Path'] || '').replace(/'/g, '').trim();
        return p.split('/').pop().trim();
    }

    // ---------- 3. 狀態 ----------
    var DATA = [];
    // 篩選順序：1 Place → 2 Subject → 3 Location precision（選項皆從 DATA 動態讀取）
    var FILTER_KEYS = ['place_name', 'photo_subject', 'location_precision'];
    var FILTER_LABELS = { place_name: 'place_name（地點）', photo_subject: 'photo_subject（照片內容）', location_precision: 'location_precision（位置精度）' };
    var selected = {};           // key -> Set(選中的值)；空 Set = 全選
    FILTER_KEYS.forEach(function (k) { selected[k] = new Set(); });
    var markersById = {};        // 總編號 -> circleMarker
    var highlighted = null;
    var cluster, map;            // （拍攝視線圖層已移除）
    var curRec = null;           // 右欄目前顯示的記錄（lightbox 說明用）
    var filteredList = [];       // 目前通過篩選的記錄（底片條／lightbox 翻頁順序）
    var searchTerm = '';         // 搜尋關鍵字（小寫）

    function passes(rec) {
        for (var i = 0; i < FILTER_KEYS.length; i++) {
            var k = FILTER_KEYS[i];
            var s = selected[k];   // 語意：s = 被取消勾選（排除）的值集合
            if (s.size && s.has(rec[k])) return false;
        }
        if (searchTerm) {
            var hay = (rec['照片總編號'] + ' ' + rec['photo_subject'] + ' ' + rec['place_name']
                + ' ' + rec['notes'] + ' ' + rec['place/subject_information'] + ' ' + rec['拍攝者']).toLowerCase();
            if (hay.indexOf(searchTerm) === -1) return false;
        }
        return true;
    }

    // ---------- 4. 地圖 ----------
    function buildMap() {
        map = L.map('map', {
            maxZoom: 20, zoomControl: false,
            /* 縮放必須維持整數級：Leaflet.markercluster 不支援小數縮放，
               小數級會讓聚類重算錯亂（點開聚類後舊圓留在原地、全部點不開）。 */
            wheelPxPerZoomLevel: 140,    // 滾輪靈敏度調低＝一次滾動縮得少＝更順
            inertia: true, inertiaDeceleration: 3000, easeLinearity: .22   // 拖拽滑行慣性
        });
        /* 散點專屬 pane（z 620 > markerPane 600）：照片點永遠畫在聚類圓之上。
           注意：canvas renderer 不能放這一層——全幅 canvas 會蓋住聚類 divIcon、
           吞掉所有點擊（蜘蛛腿是隱形的，放回預設底層即可）。 */
        map.createPane('dots');
        map.getPane('dots').style.zIndex = 620;
        map.options.renderer = L.canvas({ padding: .5 });
        map.fitBounds([[22.277544353403083,113.92731391849313],[22.290035641847677,113.94905732371413]]);
        var overlays = {};
        // 依名稱分組：1963 航照四幅一組、現今地形圖東西幅一組，各自一鍵開關
        var tiles1963 = [], tilesModern = [];
        RASTERS.forEach(function (r) {
            var lyr = L.imageOverlay(r.url, r.bounds);
            (r.name.indexOf('1963') === 0 ? tiles1963 : tilesModern).push(lyr);
        });
        var group1963 = L.layerGroup(tiles1963).addTo(map);   // 先加（在下層）
        var groupModern = L.layerGroup(tilesModern).addTo(map); // 後加（在上層，與原版一致）
        overlays['現今地圖（東西幅）'] = groupModern;
        overlays['1963年航照（四幅合併）'] = group1963;
        cluster = L.markerClusterGroup({            showCoverageOnHover: false, maxClusterRadius: 45,
            animate: false,
            /* 點開行為回到原版：點聚類只放大一級到它的範圍（插件內建
               zoomToBoundsOnClick），玩家自己決定要不要繼續點進去；
               spiderfyOnMaxZoom:false 交由下方 clusterclick 在最大級手動散開。 */
            spiderfyOnMaxZoom: false,
            zoomToBoundsOnClick: true,
            spiderfyDistanceMultiplier: 1.35,   // 散點漂浮範圍稍大
            spiderLegPolylineOptions: { opacity: 0, weight: 0 },   // 不畫蜘蛛連線，點直接漂浮在周圍
            iconCreateFunction: function (c) {
                var n = c.getChildCount();
                var cls = 'marker-cluster cl' + (n >= 20 ? ' cl-xl' : n >= 8 ? ' cl-lg' : '');
                var size = n >= 20 ? 46 : n >= 8 ? 40 : 34;
                return L.divIcon({ html: '<span>' + n + '</span>', className: cls,
                    iconSize: [size, size] });
            }
        });
        cluster.addTo(map);
        /* 最大縮放級再點聚類 → 散開成漂浮的點（其餘級別交給插件內建放大） */
        cluster.on('clusterclick', function (a) {
            if (map.getZoom() >= map.getMaxZoom()) a.layer.spiderfy();
        });
        /* latlng → 視口座標（latLngToContainerPoint 是相對地圖容器的，
           需加上地圖容器在視口中的偏移，才能與 getBoundingClientRect 比較） */
        function clientPointOf(ll) {
            var pt = map.latLngToContainerPoint(ll);
            var mr = map.getContainer().getBoundingClientRect();
            return { x: pt.x + mr.left, y: pt.y + mr.top };
        }
        /* 散開時隱藏父聚類圓：插件預設只把父圓淡到 30% 留在原地（立體徽章下
           看起來像「聚類圓還在」），且縮放/平移會讓插件以原樣重新生成父圓、
           甚至重建整棵聚類樹——事件鉤子追不住，改用 MutationObserver 盯
           marker 圖標層：處於散開狀態時，任何「數量相同＋位置重合」的聚類圓
           一出現就立刻隱藏；收合（unspiderfied）後停止隱藏。 */
        var markerPane = map.getPane('markerPane');
        var hiddenGhosts = [];   // 被隱藏的父圓圖標（收合後要還原，避免聚類「憑空消失」）
        var ghostMO = new MutationObserver(function () {
            if (!cluster._spiderfied || !cluster._spiderfied.getLatLng) {
                // 已收合：還原所有被隱藏的圖標（縮放會重建圖標元素，
                // 只靠 unspiderfied 事件可能追不到新的那顆）
                hiddenGhosts.forEach(function (el) {
                    el.style.opacity = ''; el.style.pointerEvents = ''; });
                hiddenGhosts.length = 0;
                return;
            }
            var pt = clientPointOf(cluster._spiderfied.getLatLng());
            var n = String(cluster._spiderfied.getChildCount());
            Array.prototype.forEach.call(
                markerPane.querySelectorAll('.marker-cluster'), function (el) {
                if (el.textContent.trim() !== n) return;
                var r = el.getBoundingClientRect();
                /* 只比對「數量相同＋位置幾乎完全重合」（< 8px）：
                   父圓永遠精準坐落在散開中心，而旁邊可能有數量相同、
                   位置相近的真實聚類（如右側兩顆 6）——半徑太寬會把
                   別顆真聚類也藏掉，看起來像「點開這顆、那顆消失」。 */
                if (Math.abs(r.x + r.width / 2 - pt.x) < 8 &&
                    Math.abs(r.y + r.height / 2 - pt.y) < 8) {
                    el.style.opacity = 0;
                    el.style.pointerEvents = 'none';
                    if (hiddenGhosts.indexOf(el) === -1) hiddenGhosts.push(el);
                }
            });
        });
        ghostMO.observe(markerPane, { childList: true, subtree: true });
        /* 還原「所有」被隱藏的圖標再清空清單——只還原事件帶來的那顆，
           會讓曾經被誤判／重建過的幽靈永久卡在透明狀態（聚類憑空消失）。 */
        function restoreGhosts() {
            hiddenGhosts.forEach(function (el) {
                el.style.opacity = ''; el.style.pointerEvents = '';
            });
            hiddenGhosts.length = 0;
        }
        cluster.on('unspiderfied', function (e) {
            var el = e.cluster._icon;
            if (el) { el.style.opacity = ''; el.style.pointerEvents = ''; }
            restoreGhosts();
        });
        overlays['照片位置 (B09)'] = cluster;
        L.control.layers(null, overlays, { collapsed: true, position: 'topright' }).addTo(map);
        /* 圖層面板改為純點擊開關：
           Leaflet 預設 hover 就展開、滑走就收合、展開後圖示還會消失，
           實際操作起來像「按鈕點不到」。以下停用 hover 行為並改為點擊切換。 */
        (function () {
            var sec = document.querySelector('.leaflet-control-layers');
            if (!sec) return;
            /* 1) 攔掉 Leaflet 的 mouseenter/mouseleave（hover 展開/滑走收合） */
            var p = sec.parentElement;
            ['mouseenter', 'mouseleave'].forEach(function (t) {
                p.addEventListener(t, function (e) {
                    if (sec.contains(e.target)) e.stopPropagation();
                }, true);
            });
            /* 2) 只有點圖示才開/關面板。
               注意：不能對面板內所有點擊 stopPropagation——捕獲階段攔掉後，
               事件到不了 Leaflet 綁在更深層的 checkbox handler，圖層勾選會全部失效。
               面板內部點擊本來就到不了地圖（Leaflet 對控件容器停用了點擊傳播），
               無需在這裡多攔一層。 */
            sec.addEventListener('click', function (e) {
                if (!e.target.closest('.leaflet-control-layers-toggle')) return;
                e.stopPropagation();
                var open = !sec.classList.contains('layers-open');
                sec.classList.toggle('layers-open', open);
                sec.classList.toggle('leaflet-control-layers-expanded', open);
            }, true);
            /* 3) 點地圖空白處收合 */
            map.on('click', function () { sec.classList.remove('layers-open'); });
        })();
        L.control.zoom({ position: 'topleft' }).addTo(map);
    }

    function precClass(rec) {
        switch (rec['location_precision']) {
            case 'Exact':         return 'dot-exact';    // 綠（原版 QGIS 分類色）
            case 'Approximate':   return 'dot-approx';   // 黃
            case 'Village-level': return 'dot-village';  // 粉紅
            default:              return 'dot-other';
        }
    }

    function buildMarkers() {
        cluster.clearLayers();
        markersById = {};
        var pts = [];
        DATA.forEach(function (rec) {
            var la = parseFloat(rec['shoot_lat']), lo = parseFloat(rec['shoot_lng']);
            if (isNaN(la) || isNaN(lo)) return;
            // 立體小徽章（divIcon）：與聚類同一套 3D 語彙，放散點專屬高層
            var m = L.marker([la, lo], {
                icon: L.divIcon({ className: 'dot-wrap',
                    html: '<span class="dot-badge ' + precClass(rec) + '"></span>',
                    iconSize: [18, 18], iconAnchor: [9, 9] }),
                pane: 'dots', keyboard: false
            });
            m._pid = rec['照片總編號'];
            m.on('click', function () { selectRecord(m._pid, true); });
            markersById[m._pid] = m;
            pts.push(m);
        });
        cluster.addLayers(pts);
    }

    function refreshFilter() {
        var n = 0;
        filteredList = [];
        DATA.forEach(function (rec) {
            var m = markersById[rec['照片總編號']];
            if (!m) return;
            var show = passes(rec);
            if (show) { if (!cluster.hasLayer(m)) cluster.addLayer(m); n++; filteredList.push(rec); }
            else if (cluster.hasLayer(m)) cluster.removeLayer(m);
        });
        document.getElementById('count').textContent = n;
        document.getElementById('count').classList.toggle('zero', n === 0);
        buildFilmstrip();
    }

    // ---------- 5. 篩選面板 ----------
    function buildFilters() {
        var root = document.getElementById('filter-root');
        root.innerHTML = '';
        FILTER_KEYS.forEach(function (k, fi) {
            var vals = {};
            DATA.forEach(function (r) { var v = r[k] || '—'; vals[v] = (vals[v] || 0) + 1; });
            var keys = Object.keys(vals).sort();
            var div = document.createElement('div');
            div.className = 'fgroup';
            var html = '<h3><span class="step">' + (fi + 1) + '</span>' + esc(FILTER_LABELS[k]) + '</h3>'
                + '<div class="fbtns"><button data-act="all" data-k="' + k + '">Select all</button>'
                + '<button data-act="clear" data-k="' + k + '">Clear</button></div>';
            keys.forEach(function (v) {
                html += '<label class="fopt"><input type="checkbox" checked data-k="' + k + '" value="' + esc(v) + '">'
                    + esc(v) + ' <span class="n">(' + vals[v] + ')</span></label>';
            });
            if (k === 'location_precision') {
                html += '<div class="fnote">'
                    + '<b>Village-level</b>：只知道屬於某村落，marker 不代表精確拍攝點。<br>'
                    + '<b>Approximate</b>：位置由舊地圖、照片、筆記或其他線索估算，仍有不確定性。'
                    + '</div>';
            }
            div.innerHTML = html;
            root.appendChild(div);
        });
        root.addEventListener('click', function (e) {
            var b = e.target.closest('button');
            if (!b) return;
            var k = b.getAttribute('data-k');
            var set = selected[k];
            if (b.getAttribute('data-act') === 'all') set.clear();
            else keysOf(k).forEach(function (v) { set.add(v); });
            syncCheckbox(k);
            if (k === 'location_precision') { quickNote(''); syncUncertainBtn(); }   // 手動改動後，說明行失效、按鈕同步激活態
            refreshFilter();
        });
        root.addEventListener('change', function (e) {
            var cb = e.target;
            if (cb.tagName !== 'INPUT') return;
            var k = cb.getAttribute('data-k'), v = cb.value;
            if (cb.checked) selected[k].delete(v); else selected[k].add(v);
            if (k === 'location_precision') { quickNote(''); syncUncertainBtn(); }
            refreshFilter();
        });
    }
    function keysOf(k) {
        var s = new Set();
        DATA.forEach(function (r) { s.add(r[k] || '—'); });
        return Array.from(s);
    }
    function syncCheckbox(k) {
        var all = keysOf(k);
        document.querySelectorAll('input[data-k="' + k + '"]').forEach(function (cb) {
            cb.checked = !selected[k].has(cb.value);
        });
    }

    // ---------- 5b. 快速操作：Show uncertain locations / Reset ----------
    /* 只動 interface filter（selected 集合），不更動任何資料：
       - 按下「Show uncertain locations」→ 排除 Village-level / Approximate 以外的類別；
         若資料中只有這兩類（無 Exact 等確定類別），則顯示全部並在說明行講清楚。
       - 按下「Reset」→ 清空所有篩選與搜尋，還原全部。 */
    var UNCERTAIN_PREC = ['Approximate', 'Village-level'];
    var btnUncertain = document.getElementById('btnUncertain');
    function uncertainActive() {
        // 激活態＝資料中所有「確定類別」都被排除（即只留 Village-level / Approximate）
        var excluded = selected.location_precision;
        var hasCertain = false;
        for (var i = 0; i < DATA.length; i++) {
            var v = DATA[i]['location_precision'] || '—';
            if (UNCERTAIN_PREC.indexOf(v) === -1) {
                hasCertain = true;
                if (!excluded.has(v)) return false;
            }
        }
        return hasCertain;   // 資料只有兩類時，按鈕不呈現激活色（顯示全部＋說明）
    }
    function syncUncertainBtn() { btnUncertain.classList.toggle('on', uncertainActive()); }
    function quickNote(html) {
        var el = document.getElementById('quickNote');
        if (!html) { el.className = ''; el.innerHTML = ''; return; }
        el.innerHTML = html;
        el.className = 'show';
    }
    function precCounts() {
        var c = {};
        DATA.forEach(function (r) {
            var v = r['location_precision'] || '—';
            c[v] = (c[v] || 0) + 1;
        });
        return c;
    }
    btnUncertain.addEventListener('click', function () {
        var c = precCounts();
        var certain = Object.keys(c).filter(function (v) {
            return UNCERTAIN_PREC.indexOf(v) === -1;
        });
        if (!certain.length) {
            // 資料只有這兩類 → 無確定類別可排除，顯示全部並說明
            FILTER_KEYS.forEach(function (k) { selected[k].clear(); });
            FILTER_KEYS.forEach(syncCheckbox);
            syncUncertainBtn();
            refreshFilter();
            quickNote('<b>說明：</b>本資料集的 location_precision 只有 <b>Village-level</b>（'
                + (c['Village-level'] || 0) + ' 筆）與 <b>Approximate</b>（'
                + (c['Approximate'] || 0) + ' 筆）兩類——所有照片的位置都帶有不確定性，因此顯示全部 '
                + DATA.length + ' 筆記錄。');
            return;
        }
        /* 讓「Show uncertain locations」的承諾成立：按下後結果就「只」是
           Village-level / Approximate 的記錄——因此同時清空其他篩選，
           避免殘留的地點／內容篩選把結果 intersect 成 0 筆（介面篩選，不動資料）。 */
        selected.place_name.clear();
        selected.photo_subject.clear();
        FILTER_KEYS.forEach(syncCheckbox);
        selected.location_precision = new Set(certain);   // 排除確定類別（= 只留兩類不確定）
        syncCheckbox('location_precision');
        syncUncertainBtn();
        refreshFilter();
        quickNote('已只顯示位置不確定的記錄（<b>Approximate</b>、<b>Village-level</b>）；隱藏 '
            + certain.map(function (v) { return '<b>' + esc(v) + '</b>（' + c[v] + ' 筆）'; }).join('、')
            + '。可再按 Reset 還原。');
    });
    document.getElementById('btnReset').addEventListener('click', function () {
        FILTER_KEYS.forEach(function (k) { selected[k].clear(); });
        searchTerm = '';
        document.getElementById('search').value = '';
        FILTER_KEYS.forEach(syncCheckbox);
        syncUncertainBtn();
        quickNote('');
        refreshFilter();
    });

    // ---------- 6. 右欄詳情 ----------
    function selectRecord(pid, scroll) {
        var rec = null;
        for (var i = 0; i < DATA.length; i++) { if (DATA[i]['照片總編號'] === pid) { rec = DATA[i]; break; } }
        if (!rec) return;
        curRec = rec;
        // highlight
        if (highlighted && markersById[highlighted]) {
            var oldEl = markersById[highlighted].getElement && markersById[highlighted].getElement();
            if (oldEl) oldEl.classList.remove('hi');
        }
        highlighted = pid;
        var m = markersById[pid];
        if (m) {
            var el = m.getElement && m.getElement();
            if (el) el.classList.add('hi');
        }
        // panel
        var fn = fileName(rec);
        function coord(lat, lng) {
            if (!lat || !lng || isNaN(parseFloat(lat)) || isNaN(parseFloat(lng))) return '';
            return parseFloat(lat).toFixed(4) + ', ' + parseFloat(lng).toFixed(4);
        }
        var prec = rec['location_precision'] || '';
        var precCls = prec === 'Exact' ? 'b-exact' : prec === 'Approximate' ? 'b-approx' : 'b-village';
        var rows = [
            ['照片流水號', rec['照片流水號']],
            ['box no.', rec['box no.']],
            ['照片總編號', rec['照片總編號']],
            ['拍攝者', rec['拍攝者']],
            ['拍攝日期', rec['指攝日期']],
            ['底片編號', rec['底片編號']],
            ['照片內容', rec['photo_subject']],
            ['地點', rec['place_name']],
            ['描述', rec['place/subject_information']],
            ['位置精度', prec],
            ['資料來源', rec['location_source']],
            ['拍攝點', coord(rec['shoot_lat'], rec['shoot_lng'])],
            ['被攝點', coord(rec['subject_lat'], rec['subject_lng'])],
            ['定位說明', rec['location_note']]
        ];
        var html = '<div class="d-head"><div class="d-title">' + esc(rec['照片總編號']) + '</div>'
            + (prec ? '<span class="badge ' + precCls + '">' + esc(prec) + '</span>' : '')
            + '</div>'
            + '<div class="d-notes">' + esc(rec['notes']) + '</div>'
            + (fn ? '<figure class="d-photoWrap"><img class="d-photo" src="images/'
                + encodeURIComponent(fn) + '" alt="' + esc(rec['照片總編號']) + '">'
                + '<figcaption class="d-cap">' + esc(fn) + '</figcaption></figure>' : '')
            + '<div class="d-table">';
        rows.forEach(function (r) {
            var v = r[1];
            if (v !== '' && v != null) {
                var mono = (r[0] === '拍攝點' || r[0] === '被攝點') ? ' mono' : '';
                html += '<div class="d-row"><div class="d-lbl">' + r[0] + '</div>'
                    + '<div class="d-val' + mono + '">' + esc(v) + '</div></div>';
            }
        });
        html += '</div>';
        var detail = document.getElementById('detail');
        detail.innerHTML = html;
        detail.scrollTop = 0;   // 換照片時從頭閱讀，不殘留上一張的捲動位置
        // URL 分享：網址帶 #B09P02 可直接定位
        try { if (location.hash !== '#' + pid) history.replaceState(null, '', '#' + pid); } catch (err) {}
        syncFilmstripActive();
        if (scroll && window.innerWidth <= 1100) {
            detail.scrollIntoView({ behavior: 'smooth' });
        }
        // 入口提示膠囊功成身退：選中第一張照片後淡出
        (function () {
            var hint = document.getElementById('mapHint');
            if (!hint || hint.dataset.gone) return;
            hint.dataset.gone = '1';
            hint.classList.add('gone');
            setTimeout(function () { hint.style.display = 'none'; }, 1000);
        })();
    }

    // ---------- 7. Lightbox（點擊右欄照片放大，背景虛化，← → 翻頁） ----------
    var lb = document.createElement('div');
    lb.className = 'lightbox';
    lb.innerHTML = '<button class="lb-nav lb-prev" title="上一張">‹</button>'
        + '<img alt=""><button class="lb-nav lb-next" title="下一張">›</button>'
        + '<div class="lb-cap"></div><div class="lb-hint"><span id="lbPos"></span>← → 翻頁 · 點擊任意處或按 Esc 關閉</div>';
    document.body.appendChild(lb);

    function updateLightbox() {
        if (!curRec) return;
        var fn = fileName(curRec);
        if (!fn) return;
        lb.querySelector('img').src = 'images/' + encodeURIComponent(fn);
        lb.querySelector('.lb-cap').innerHTML = '<b>' + esc(curRec['照片總編號']) + '</b>'
            + esc(curRec['photo_subject'] || '')
            + (curRec['place_name'] ? ' ' + esc(curRec['place_name']) : '');
        // 位置計數（第 n / m 張）：讓玩家知道檔案翻到哪裡
        var idx = -1, i;
        for (i = 0; i < filteredList.length; i++) {
            if (filteredList[i]['照片總編號'] === curRec['照片總編號']) { idx = i; break; }
        }
        var pos = lb.querySelector('#lbPos');
        if (pos) pos.textContent = (filteredList.length && idx > -1)
            ? (idx + 1) + ' / ' + filteredList.length + ' · ' : '';
    }
    function lbStep(d) {
        if (!curRec || !filteredList.length) return;
        var idx = -1, i;
        for (i = 0; i < filteredList.length; i++) {
            if (filteredList[i]['照片總編號'] === curRec['照片總編號']) { idx = i; break; }
        }
        idx = (idx === -1 ? 0 : idx + d + filteredList.length) % filteredList.length;
        selectRecord(filteredList[idx]['照片總編號']);
        updateLightbox();
    }
    lb.addEventListener('click', function () { lb.classList.remove('open'); });
    lb.querySelector('.lb-prev').addEventListener('click', function (e) { e.stopPropagation(); lbStep(-1); });
    lb.querySelector('.lb-next').addEventListener('click', function (e) { e.stopPropagation(); lbStep(1); });
    document.addEventListener('keydown', function (e) {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape') lb.classList.remove('open');
        else if (e.key === 'ArrowLeft') { e.preventDefault(); lbStep(-1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); lbStep(1); }
    });
    document.getElementById('detail').addEventListener('click', function (e) {
        var w = e.target.closest ? e.target.closest('.d-photoWrap') : null;
        if (!w || !curRec) return;
        var img = w.querySelector('img');
        if (!img || !img.naturalWidth) return;
        updateLightbox();
        lb.classList.add('open');
    });

    // ---------- 7b. 底片條（隨篩選連動，點擊定位地圖） ----------
    function buildFilmstrip() {
        var el = document.getElementById('filmstrip');
        var html = '';
        filteredList.forEach(function (rec) {
            var fn = fileName(rec);
            if (!fn) return;
            html += '<img loading="lazy" src="images/' + encodeURIComponent(fn) + '" data-pid="'
                + esc(rec['照片總編號']) + '" title="' + esc(rec['照片總編號']) + '" alt="">';
        });
        // 空狀態：沒有任何符合的記錄時給一句話，而不是無聲消失
        if (!html) html = '<span class="fs-empty">沒有符合的記錄 — 調整篩選或清除搜尋再試</span>';
        el.innerHTML = html;
        syncFilmstripActive();
    }
    function syncFilmstripActive() {
        var el = document.getElementById('filmstrip');
        var imgs = el.querySelectorAll('img');
        for (var i = 0; i < imgs.length; i++) {
            var on = curRec && imgs[i].getAttribute('data-pid') === curRec['照片總編號'];
            imgs[i].classList.toggle('active', !!on);
            if (on) imgs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
    }
    function jumpToRecord(pid) {
        selectRecord(pid, true);
        var m = markersById[pid];
        if (m) {
            if (map.getZoom() < 15) map.setView(m.getLatLng(), 15);
            else map.panTo(m.getLatLng());
        }
    }
    document.getElementById('filmstrip').addEventListener('click', function (e) {
        var img = e.target.closest ? e.target.closest('img') : null;
        if (img && img.getAttribute('data-pid')) jumpToRecord(img.getAttribute('data-pid'));
    });

    // ---------- 7c. 搜尋框 ----------
    document.getElementById('search').addEventListener('input', function () {
        // 關鍵字也過簡→繁轉換：貼上原始 CSV 的簡體詞（如「马湾涌」）同樣搜得到
        searchTerm = toTraditional(this.value.trim().toLowerCase());
        refreshFilter();
    });

    // ---------- 8. 啟動 ----------
    buildMap();
    // 供除錯／自動化測試存取
    window.map = map; window.cluster = cluster;

    /* ---------- 8b. 鼠標遊動（map drift） ----------
       滑鼠在地圖上偏離中心時，地圖緩緩向該方向滑動（探索「跟著滑鼠遊」的感覺）；
       中央 16% 死區內不動、每幀最大 5.5px、速度 lerp 平滑；
       按住拖拽或縮放動畫時暫停，滑出地圖自然減速歸停。 */
    (function () {
        var mouse = null, vx = 0, vy = 0, paused = false, raf = null;
        var el = document.getElementById('map');
        el.addEventListener('mousemove', function (e) {
            var r = el.getBoundingClientRect();
            mouse = { x: (e.clientX - r.left) / r.width - .5,
                      y: (e.clientY - r.top) / r.height - .5 };
            kick();
        });
        el.addEventListener('mouseleave', function () { mouse = null; kick(); });
        el.addEventListener('mousedown', function () { paused = true; }, true);
        document.addEventListener('mouseup', function () { paused = false; kick(); });
        map.on('zoomstart', function () { paused = true; });
        map.on('zoomend', function () { paused = false; kick(); });
        function kick() { if (raf === null) raf = requestAnimationFrame(step); }
        function step() {
            raf = null;
            var tx = 0, ty = 0;
            if (mouse && !paused) {
                var dead = .16, span = .34;   // 死區 16%、死區到邊緣線性加速
                var ax = Math.abs(mouse.x) - dead, ay = Math.abs(mouse.y) - dead;
                if (ax > 0) tx = (mouse.x > 0 ? 1 : -1) * Math.min(ax / span, 1);
                if (ay > 0) ty = (mouse.y > 0 ? 1 : -1) * Math.min(ay / span, 1);
                tx *= 5.5; ty *= 5.5;
            }
            vx += (tx - vx) * .07;
            vy += (ty - vy) * .07;
            if (Math.abs(vx) > .06 || Math.abs(vy) > .06) {
                map.panBy([vx, vy], { animate: false, noMoveStart: true });
                raf = requestAnimationFrame(step);
            }
        }
    })();

    /* 原始 CSV 以簡體字記錄（马湾涌、渔民村、张振江…）。
       原始資料檔不更動——載入後在此統一轉為繁體顯示（含搜尋與篩選標籤），
       23 字映射即資料中全部會出現的簡體字；對已是繁體的文字為無作用。 */
    var S2T = { 东: '東', 内: '內', 划: '劃', 动: '動', 单: '單', 号: '號', 头: '頭',
        张: '張', 户: '戶', 机: '機', 桥: '橋', 楼: '樓', 渔: '漁', 游: '遊', 湾: '灣',
        码: '碼', 简: '簡', 边: '邊', 还: '還', 门: '門', 颜: '顏', 马: '馬', 鱼: '魚' };
    function toTraditional(text) {
        return text.replace(/[东内划动单号头张户机桥楼渔游湾码简边还门颜马鱼]/g,
            function (c) { return S2T[c]; });
    }

    function applyCSV(text) {
        DATA = parseCSV(toTraditional(text));
        if (!DATA.length) throw new Error('CSV 內容為空');
        document.getElementById('total').textContent = DATA.length;
        buildMarkers();
        buildFilters();
        refreshFilter();
        window.markersById = markersById;
        // URL #B09P02 → 載入後直接定位該照片
        var h = location.hash.slice(1);
        if (h && markersById[h]) jumpToRecord(h);
    }
    (function loadCSV(idx) {
        var embedEl = document.getElementById('csv-embed');
        if (idx >= CSV_CANDIDATES.length) {
            if (embedEl && embedEl.textContent.trim()) {
                applyCSV(embedEl.textContent);
                document.getElementById('count').title = 'file:// 模式：使用頁面內嵌的 CSV 快照';
                return;
            }
            document.getElementById('filter-root').innerHTML =
                '<div class="err">無法載入 individualphoto(B09).csv。<br>請以 module1/ 為伺服器根目錄開啟本頁（例如 python3 -m http.server 於 module1/ 執行）。</div>';
            return;
        }
        fetch(CSV_CANDIDATES[idx]).then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.text();
        }).then(function (text) {
            applyCSV(text);
        }).catch(function () { loadCSV(idx + 1); });
    })(0);
})();
</script>

<!-- ================= 工作台場景與檔案簿（合併自 workbench.html） ================= -->
<script>
(function () {
    'use strict';
    var wb = document.getElementById('workbench');
    var bookWrap = document.getElementById('bookWrap');
    var toast = document.getElementById('toast');
    var fade = document.getElementById('wbFade');
    var toastTimer = null;
    function showToast(msg) {
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 1800);
    }
    /* 1992 Archive → 同頁黑幕淡出切換到地圖 */
    function enterMap() {
        fade.classList.add('on');
        setTimeout(function () {
            wb.classList.add('hidden');
            fade.classList.remove('on');
            if (window.map) window.map.invalidateSize();
        }, 700);
    }
    function showWorkbench() {
        bookWrap.classList.remove('open');
        document.getElementById('hint').style.display = '';
        wb.classList.remove('hidden');
    }
    document.getElementById('deskHotspot').addEventListener('click', function () {
        document.getElementById('hint').style.display = 'none';
        bookWrap.classList.add('open');
        renderZ();
    });
    document.getElementById('bookClose').addEventListener('click', function () {
        bookWrap.classList.remove('open');
        document.getElementById('hint').style.display = '';
    });
    /* 地圖左上 ⌂ → 返回工作台場景 */
    document.getElementById('backHome').addEventListener('click', function (e) {
        e.preventDefault();
        showWorkbench();
    });

    /* ---------- 檔案簿（翻頁） ---------- */
    function folder(o) {
        if (o.open) {
            return '<div class="folder open-able">'
                + '<span class="ftab">' + o.tab + '</span><div class="fbody">'
                + '<div class="flabel">' + o.label + '<small>' + o.small + '</small></div>'
                + '<span class="stamp">▶ 點擊開啟</span></div></div>';
        }
        return '<div class="folder locked" data-lock="1">'
            + '<span class="ftab">' + o.tab + '</span><div class="fbody">'
            + '<div class="flabel">' + o.label + '<small>' + o.small + '</small></div>'
            + '<span class="stamp">🔒 未開放</span></div></div>';
    }
    var sheets = [
        { // 封面 | 內頁左：說明
            front: '<div class="face cover"><div class="emboss">田野檔案室</div>'
                + '<div class="sub">FIELD ARCHIVE · ANTH3323</div>'
                + '<div class="open-tip">— 點擊右頁翻開 —</div></div>',
            back: '<div class="face back paper"><h3>檔案室說明</h3>'
                + '<p>本工作台收藏 1992 年於大嶼山馬灣涌進行的田野照片檔案。</p>'
                + '<p style="margin-top:8px">牆上的家戶譜系與軟木板照片，來自當年的田野記錄。</p>'
                + '<p class="note">目前僅「1992 Archive」檔案夾開放閱覽，其餘檔案夾尚未整理完成。</p>'
                + '<div class="gutter"></div></div>'
        },
        { // 右頁：檔案夾一
            front: '<div class="face paper"><h3>檔案夾 · 一</h3><div class="folders">'
                + folder({ tab: '1992 Archive', open: true,
                    label: 'B09 照片檔案', small: '馬灣涌 · 1992 · 31 張照片地圖' })
                + folder({ tab: 'Field Notes', label: '田野筆記', small: '1991–1992 · 未整理' })
                + folder({ tab: 'Family Tree', label: '家戶譜系圖', small: '馬灣涌各戶 · 建檔中' })
                + '</div><div class="gutter"></div></div>',
            back: '<div class="face back paper"><h3>待歸檔</h3>'
                + '<p>底片目錄、訪談謄本與地圖底稿仍在整理。</p>'
                + '<p class="note">— 等待未來的田野 —</p><div class="gutter"></div></div>'
        },
        { // 右頁：檔案夾二
            front: '<div class="face paper"><h3>檔案夾 · 二</h3><div class="folders">'
                + folder({ tab: 'Oral History', label: '口述歷史', small: '漁戶訪談 · 未開放' })
                + folder({ tab: 'Clippings', label: '報章剪輯', small: '1990s 東涌發展 · 未開放' })
                + folder({ tab: 'Negatives', label: '底片目錄', small: '9- / 11- / 12- / 16- 系列' })
                + '</div><div class="gutter"></div></div>',
            back: '<div class="face back paper" style="display:flex;align-items:center;justify-content:center">'
                + '<p style="text-align:center;font-family:\'Songti TC\',serif;font-size:15px;letter-spacing:.3em;color:#8a744c">'
                + '— 未 開 放 的 檔 案 —</p><div class="gutter"></div></div>'
        }
    ];
    var book = document.getElementById('book');
    var flipped = 0;
    sheets.forEach(function (s, i) {
        var d = document.createElement('div');
        d.className = 'sheet'; d.dataset.idx = i;
        d.innerHTML = s.front + s.back;
        book.appendChild(d);
    });
    var sheetEls = [].slice.call(book.querySelectorAll('.sheet'));
    var pgInd = document.getElementById('pgInd');
    var NAMES = ['封面', '檔案夾 · 一', '檔案夾 · 二', '封底'];
    function renderZ() {
        sheetEls.forEach(function (el, i) {
            var f = i < flipped;
            el.classList.toggle('flipped', f);
            el.style.zIndex = f ? i + 1 : sheetEls.length - i;
            /* 兩面可見度：不依賴 backface-visibility（部分引擎不支援），
               翻頁時 crossfade，與翻轉同步 */
            var front = el.querySelector('.face:not(.back)');
            var back = el.querySelector('.face.back');
            front.style.opacity = f ? 0 : 1;
            front.style.visibility = f ? 'hidden' : 'visible';
            back.style.opacity = f ? 1 : 0;
            back.style.visibility = f ? 'visible' : 'hidden';
        });
        pgInd.textContent = NAMES[Math.min(flipped, NAMES.length - 1)];
        document.getElementById('pgPrev').disabled = flipped === 0;
        document.getElementById('pgNext').disabled = flipped === sheetEls.length;
    }
    document.getElementById('pgNext').addEventListener('click', function () {
        if (flipped < sheetEls.length) { flipped++; renderZ(); }
    });
    document.getElementById('pgPrev').addEventListener('click', function () {
        if (flipped > 0) { flipped--; renderZ(); }
    });
    renderZ();

    /* 檔案夾點擊：只有 1992 Archive 可進入 */
    book.addEventListener('click', function (e) {
        var f = e.target.closest('.folder');
        if (!f) return;
        if (f.classList.contains('open-able')) {
            enterMap();
        } else {
            f.classList.remove('shake');
            void f.offsetWidth;
            f.classList.add('shake');
            showToast('此檔案夾尚未開放 — 僅 1992 Archive 可閱覽');
        }
    });

    /* 書本自適應縮放 */
    function fit() {
        var s = Math.min(1, (window.innerWidth - 60) / 680, (window.innerHeight - 140) / 460);
        document.documentElement.style.setProperty('--bs', Math.max(.4, s));
    }
    window.addEventListener('resize', fit);
    fit();

    /* URL 帶 #B09Pxx 分享連結時，直接進入地圖（略過工作台） */
    if (/^B09P/.test(location.hash.slice(1))) wb.classList.add('hidden');

    /* ---------- 鼠標驅動 3D：檔案簿跟隨滑鼠傾斜 ----------
       場景板塊的 hover 放大由 CSS :hover 完成（見上方 .fx 規則）。 */
    var p = { bx: 0, by: 0 };   // 書本目前角度（deg）
    var tg = { bx: 0, by: 0 };  // 目標角度
    var rafId = null;
    function tick() {
        var k = .085, done = true, key;
        for (key in tg) {
            p[key] += (tg[key] - p[key]) * k;
            if (Math.abs(tg[key] - p[key]) > .02) done = false;
        }
        wb.style.setProperty('--bry', p.bx.toFixed(3) + 'deg');
        wb.style.setProperty('--brx', p.by.toFixed(3) + 'deg');
        rafId = done ? null : requestAnimationFrame(tick);
    }
    function kick() { if (rafId === null) rafId = requestAnimationFrame(tick); }
    wb.addEventListener('mousemove', function (e) {
        var nx = e.clientX / window.innerWidth - .5;    // -0.5 ~ 0.5
        var ny = e.clientY / window.innerHeight - .5;
        tg.bx = nx * 10;     // 書本左右轉 ≤10°
        tg.by = -ny * 7;     // 書本上下轉 ≤7°
        kick();
    });
    wb.addEventListener('mouseleave', function () {
        tg.bx = tg.by = 0;
        kick();
    });
})();
</script>
</body>
</html>
