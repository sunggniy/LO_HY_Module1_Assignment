            <circle cx="346" cy="236" r="4" fill="#2e6da4"/>
        </g>
        </g>
        <!-- 家族樹背景板（右牆，保留；視差板塊） -->
        <g class="tree-poster fx" data-d="7">
            <rect x="905" y="86" width="252" height="330" fill="#d9cfb4" stroke="#b3a67f" stroke-width="4"/>
