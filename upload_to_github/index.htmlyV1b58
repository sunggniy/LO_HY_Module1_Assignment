<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>田野工作台 · B09 照片檔案 (1992)</title>
    <link rel="stylesheet" href="css/leaflet.css">
    <link rel="stylesheet" href="css/MarkerCluster.css">
    <link rel="stylesheet" href="css/MarkerCluster.Default.css">
    <style>
        :root {
            /* 做舊羊皮紙配色：1992 檔案的紙感 */
            --paper: #f0e9d6;
            --card: #f8f3e5;
            --card2: #f2ecdb;
            --ink: #3a332a;
            --muted: #8a7f68;
            --line: #ddd2b8;
            --accent: #a63d2f;       /* 硃紅 */
            --accent-dark: #7e2e24;
            --gold: #b8923f;
            --serif: "Songti TC", "Noto Serif TC", "STSong", "SimSun", serif;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; height: 100%;
            font-family: -apple-system, "PingFang TC", "Microsoft JhengHei", sans-serif;
            color: var(--ink); background: var(--paper); }
        /* 做舊質感：紙張顆粒只印在左右欄背景（不再用 fixed 疊層蓋住地圖——
           mix-blend 合成層會跟地圖每幀動畫重繪，是縮放卡頓主因）；
           邊緣泛黃暗角保留（單層漸層，合成成本低）。 */
        body::after { content: ""; position: fixed; inset: 0; z-index: 9989;
            pointer-events: none;
            background: radial-gradient(ellipse at 50% 42%, rgba(0,0,0,0) 58%, rgba(84,64,34,.14) 100%); }
        .app { display: grid; height: 100vh;
            /* 照片檔案欄加寬（370→500px），地圖相應縮窄：
               地圖是探索 archive 的入口，點選後在寬欄裡閱讀照片與脈絡 */
            grid-template-columns: 280px 1fr 500px;
            grid-template-areas: "filters map detail"; }
        /* 紙張顆粒：烘進欄位背景（SVG rect 不透明度≈.05×.7），地圖不受影響 */
        .col-filters { grid-area: filters; overflow-y: auto; padding: 18px 16px 22px;
            background-color: var(--card); background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/><feColorMatrix type='saturate' values='0'/></filter><rect width='160' height='160' filter='url(%23n)' opacity='0.035'/></svg>");
            border-right: 1px solid var(--line);
            position: relative; }
        .col-map { grid-area: map; position: relative; }
        .col-detail { grid-area: detail; overflow-y: auto; padding: 20px 24px 26px;
            background-color: var(--paper); background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/><feColorMatrix type='saturate' values='0'/></filter><rect width='160' height='160' filter='url(%23n)' opacity='0.035'/></svg>");
            border-left: 1px solid var(--line);
            position: relative; }
        /* ---- 毛邊（撕紙邊）：蓋在兩欄與地圖交界的不規則撕口 ----
           SVG 鋸齒路徑 repeat-y，drop-shadow 沿透明邊緣產生撕口陰影 */
        .col-filters::after, .col-detail::after {
            content: ""; position: absolute; top: 0; bottom: 0; width: 14px;
            pointer-events: none; z-index: 5;
            background-size: 14px 130px; background-repeat: repeat-y;
            filter: drop-shadow(0 0 4px rgba(80,62,34,.22)); }
        .col-filters::after { right: -1px;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='130'><path d='M0,0 L0,130 L7,126 L3,119 L10,112 L4,104 L9,96 L3,88 L11,80 L4,72 L9,64 L3,55 L10,47 L5,38 L11,30 L4,22 L9,14 L3,7 L8,2 L6,0 Z' fill='%23f8f3e5'/></svg>"); }
        .col-detail::after { left: -1px;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='130'><path d='M14,0 L14,130 L7,126 L10,119 L4,112 L11,104 L5,96 L9,88 L3,80 L10,72 L5,64 L11,55 L4,47 L9,38 L3,30 L10,22 L5,14 L11,7 L6,2 L8,0 Z' fill='%23f0e9d6'/></svg>"); }
        #map { width: 100%; height: 100%; background: #ffffff; }
        /* 航照大圖交給 GPU 合成，縮放平移更順 */
        .leaflet-image-layer { will-change: transform; }
        /* 地圖邊緣做舊：內陰影泛黃（在圖層控件與底片條之下） */
        .col-map::after { content: ""; position: absolute; inset: 0; z-index: 890;
            pointer-events: none;
            box-shadow: inset 0 0 70px rgba(96,74,40,.20); }

        /* ---- 捲軸 ---- */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #d3c7a8; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #bfb292; }

        /* ---- 左欄：品牌區 ---- */
        .brand { padding: 6px 2px 14px; border-bottom: 2px solid var(--ink); margin-bottom: 14px; }
        .brand-tag { font-size: 10px; letter-spacing: .14em; color: var(--accent);
            text-transform: uppercase; margin-bottom: 6px; font-weight: 600; }
        h1 { font-family: var(--serif); font-size: 21px; margin: 0 0 5px; letter-spacing: .04em; }
        .sub { font-size: 11.5px; color: var(--muted); line-height: 1.5; }

        /* ---- 計數卡 ---- */
        .count-box { background: linear-gradient(135deg, #faf5e6, #f3ecd7);
            border: 1px solid #e0d5b8; border-left: 3px solid var(--gold);
            border-radius: 8px; padding: 10px 12px; margin-bottom: 16px;
            display: flex; align-items: baseline; justify-content: space-between; }
        .count-box .c-lbl { font-size: 11px; color: var(--muted); letter-spacing: .05em; }
        .count-box b { font-family: var(--serif); font-size: 22px; color: var(--accent); font-weight: 700; }
        .count-box .c-sep { margin: 0 3px; color: #c2b694; font-size: 13px; }
        .count-box #total { font-size: 13px; color: var(--muted); }
        /* 0 筆時數字轉灰，一眼看出「目前沒有東西」而不是壞掉 */
        .count-box b.zero { color: #c2b694; }

        /* ---- 篩選群組 ---- */
        .fgroup { margin-bottom: 18px; border-top: 1px solid var(--line); padding-top: 12px; }
        .fgroup h3 { font-size: 11px; margin: 0 0 8px; color: var(--ink);
            letter-spacing: .1em; font-weight: 700;
            display: flex; align-items: center; gap: 6px; }
        .fgroup h3 .step { display: inline-flex; align-items: center; justify-content: center;
            width: 16px; height: 16px; border-radius: 50%; flex: none;
            background: var(--accent); color: #fff; font-size: 9.5px;
            font-weight: 700; letter-spacing: 0; font-family: -apple-system, sans-serif; }
        .tagline { font-size: 11.5px; line-height: 1.65; color: #6e6752;
            font-style: italic; margin: 0 0 14px; padding: 9px 11px;
            background: #f6f0dd; border-left: 2px solid var(--accent);
            border-radius: 0 6px 6px 0; }
        .fgroup .fbtns { display: flex; gap: 6px; margin-bottom: 8px; }
        button { font-size: 11px; padding: 3px 12px; border: 1px solid #c9bfa4; background: transparent;
            color: #6e6752; border-radius: 99px; cursor: pointer; transition: all .15s; }
        button:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
        .fopt { display: flex; align-items: flex-start; gap: 6px; font-size: 12px;
            padding: 3px 6px; margin: 0 -6px; cursor: pointer; border-radius: 5px;
            line-height: 1.45; transition: background .12s; }
        .fopt:hover { background: #f1ebd8; }
        .fopt input { margin: 2px 0 0; accent-color: var(--accent); flex: none; }
        .fopt .n { color: #b0a78d; font-size: 10px; white-space: nowrap; }
        .fnote { margin-top: 8px; padding: 9px 11px; background: #f0ead6;
            border-left: 2px solid var(--gold); border-radius: 0 6px 6px 0;
            font-size: 11px; line-height: 1.6; color: #77705e; }
        .fnote b { color: #5c553f; font-weight: 600; }

        /* ---- 快速操作（Show uncertain / Reset） ---- */
        .quick-actions { display: flex; gap: 6px; align-items: center;
            margin: 0 0 12px; flex-wrap: wrap; }
        .quick-actions button { padding: 5px 13px; font-size: 11.5px; }
        /* 激活態才上色：篩選未生效時是普通按鈕 */
        .quick-actions button.on { background: var(--accent); border-color: var(--accent);
            color: #fff; font-weight: 600; }
        .quick-actions button.on:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
        #quickNote { display: none; font-size: 11px; line-height: 1.6; color: #77705e;
            background: #f0ead6; border-left: 2px solid var(--accent);
            border-radius: 0 6px 6px 0; padding: 8px 11px; margin: 0 0 12px; }
        #quickNote.show { display: block; }

        /* ---- 右欄詳情 ---- */
        .detail-empty { color: #a49b83; font-size: 13px; text-align: center; margin: 70px 20px 0;
            padding: 40px 16px; border: 1.5px dashed #d5ccb2; border-radius: 10px; line-height: 1.8; }
        .d-head { display: flex; align-items: center; justify-content: space-between; gap: 8px;
            margin-bottom: 4px; }
        .d-title { font-family: var(--serif); font-weight: 700; font-size: 23px; letter-spacing: .03em; }
        .badge { font-size: 10px; padding: 3px 9px; border-radius: 99px; font-weight: 600;
            letter-spacing: .04em; white-space: nowrap; }
        .b-exact    { background: #e4efe2; color: #3d6b3d; border: 1px solid #bcd8ba; }
        .b-approx   { background: #faf0da; color: #8a6414; border: 1px solid #e6d3a1; }
        .b-village  { background: #eee9dd; color: #7a7259; border: 1px solid #d8d0ba; }
        .d-notes { font-size: 12px; color: var(--muted); margin: 2px 0 12px; line-height: 1.55; }
        .d-photoWrap { margin: 0 0 14px; background: #fbf7ec; padding: 7px 7px 4px;
            border: 1px solid var(--line); border-radius: 4px;
            box-shadow: 0 4px 16px rgba(70,55,30,.18); }
        .d-photo { width: 100%; display: block; border-radius: 2px; background: #eee; }
        .d-cap { font-size: 10px; color: #b0a78d; text-align: center; padding: 5px 0 3px;
            letter-spacing: .08em; }
        .d-table { width: 100%; background: var(--card); border: 1px solid var(--line);
            border-radius: 8px; overflow: hidden; border-collapse: separate; border-spacing: 0; }
        .d-row { display: flex; border-bottom: 1px solid #ece4cd; }
        .d-row:last-child { border-bottom: none; }
        .d-lbl { color: var(--muted); white-space: nowrap; width: 104px; flex: none;
            font-size: 11px; padding: 8px 12px; background: #f5efdd;
            border-right: 1px solid #ece4cd; }
        .d-val { font-size: 12.5px; padding: 8px 12px; line-height: 1.6; flex: 1; min-width: 0; }
        .d-val.mono { font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 11px; color: #6b5f47; }
        .d-missing { color: #b5ac94; }
        .err { color: #b33; font-size: 13px; padding: 12px; }
        .legend-note { font-size: 10.5px; color: #a49b83; margin-top: 14px; line-height: 1.7;
            padding-top: 12px; border-top: 1px solid var(--line); }
        .legend { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-bottom: 16px;
            padding: 9px 11px; background: #efe8d2; border-radius: 6px; }
        .legend span { font-size: 11px; color: #5c553f; display: flex; align-items: center; gap: 5px; }
        .legend i { width: 10px; height: 10px; border-radius: 50%; flex: none;
            border: 1px solid #232323; display: inline-block; }

        /* ---- 自訂聚類圓（保留 marker-cluster 基底 class 供 markercluster 動畫運作） ----
           統一配色：不分數量檔位，全部同款紙白；立體感靠徑向漸層＋內外陰影。 */
        .marker-cluster.cl { background: transparent; border: none; }
        .marker-cluster.cl span { display: flex; align-items: center; justify-content: center;
            width: 100%; height: 100%; border-radius: 50%;
            background: radial-gradient(circle at 32% 28%, #fffdf4 0%, #fbf3dd 48%, #eedcb4 100%);
            border: 2px solid var(--accent);
            color: var(--accent-dark); font-weight: 700; font-family: var(--serif);
            box-shadow: 0 4px 10px rgba(70,40,20,.32),
                        0 1px 3px rgba(70,40,20,.28),
                        inset 0 -4px 7px rgba(166,61,47,.16),
                        inset 0 2px 3px rgba(255,255,255,.95); }

        /* ---- 散點：立體小徽章（蜘蛛展開時漂浮在聚類周圍、無連線） ---- */
        .dot-wrap { background: transparent; border: none; }
        .dot-badge { display: block; width: 16px; height: 16px; border-radius: 50%;
            border: 1.5px solid rgba(35,35,35,.85);
            box-shadow: 0 3px 7px rgba(70,40,20,.4),
                        inset 0 -3px 5px rgba(0,0,0,.22),
                        inset 0 2px 3px rgba(255,255,255,.55);
            transition: transform .18s, box-shadow .18s; }
        .dot-exact   { background: radial-gradient(circle at 32% 28%, #7ed46a, #33a02c 55%, #1f7a1d); }
        .dot-approx  { background: radial-gradient(circle at 32% 28%, #fffb82, #fff400 55%, #d8cf00); }
        .dot-village { background: radial-gradient(circle at 32% 28%, #ffd0d0, #fb9a99 55%, #e07776); }
        .dot-other   { background: radial-gradient(circle at 32% 28%, #d8cfc0, #9a917c 55%, #7a705c); }
        /* hover 回饋：聚類徽章與散點懸停輕微放大，讓「可以按」看得見 */
        .marker-cluster.cl span { transition: transform .18s; }
        .marker-cluster.cl:hover span { transform: scale(1.1); }
        .dot-wrap:hover .dot-badge { transform: scale(1.3);
            box-shadow: 0 4px 9px rgba(70,40,20,.5),
                        inset 0 -3px 5px rgba(0,0,0,.22),
                        inset 0 2px 3px rgba(255,255,255,.55); }
        /* 選中：金色球體＋白圈，跟聚類徽章同一套立體語彙 */
        .dot-wrap.hi { z-index: 9999; }
        .dot-wrap.hi .dot-badge { transform: scale(1.5);
            background: radial-gradient(circle at 32% 28%, #ffe9a8, #e8b64c 55%, #c19130);
            border-color: rgba(255,255,255,.95);
            box-shadow: 0 0 0 2.5px #fff, 0 5px 10px rgba(70,40,20,.45); }

        /* ---- Lightbox 點擊放大 ---- */
        .d-photoWrap { cursor: zoom-in; transition: transform .2s, box-shadow .2s; }
        .d-photoWrap:hover { transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(70,55,30,.26); }
        .lightbox { position: fixed; inset: 0; z-index: 99999; display: none;
            flex-direction: column; align-items: center; justify-content: center;
            padding: 24px; background: rgba(24, 19, 12, .78);
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
            cursor: zoom-out; opacity: 0; transition: opacity .2s; }
        .lightbox.open { display: flex; opacity: 1; }
        .lightbox img { max-width: 92vw; max-height: 80vh; display: block;
            background: #fff; padding: 6px; border-radius: 3px;
            box-shadow: 0 16px 60px rgba(0,0,0,.55); }
        .lb-cap { margin-top: 16px; color: #f5efe0; font-size: 14px;
            letter-spacing: .04em; text-align: center; line-height: 1.6;
            text-shadow: 0 1px 6px rgba(0,0,0,.65); }
        .lb-cap b { color: #e8b64c; font-weight: 700; margin-right: 8px; }
        .lb-hint { margin-top: 10px; color: rgba(245,239,224,.55); font-size: 11px;
            letter-spacing: .08em; }
        .lb-hint #lbPos { color: #e8b64c; margin-right: 6px; }

        /* ---- 搜尋框 ---- */
        .search-box { position: relative; margin-bottom: 14px; }
        .search-box input { width: 100%; font-size: 12px; padding: 8px 12px 8px 30px;
            border: 1px solid #c9bfa4; border-radius: 99px; background: #fdfaf0;
            color: var(--ink); outline: none; font-family: inherit;
            transition: border-color .15s, box-shadow .15s; }
        .search-box input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(166,61,47,.12); }
        .search-box input::placeholder { color: #b0a78d; }
        .search-box::before { content: "⌕"; position: absolute; left: 11px; top: 50%;
            transform: translateY(-50%); font-size: 14px; color: #a49b83; pointer-events: none; }

        /* ---- 底片條 ---- */
        #filmstrip { position: absolute; left: 12px; right: 12px; bottom: 12px; z-index: 900;
            display: flex; gap: 6px; overflow-x: auto; padding: 8px 10px;
            background: rgba(250, 246, 234, .94); border: 1px solid var(--line);
            border-radius: 10px; box-shadow: 0 4px 16px rgba(70,55,30,.2); }
        #filmstrip img { height: 52px; border-radius: 4px; cursor: pointer; flex: none;
            border: 2px solid transparent; opacity: .85; transition: all .12s; display: block; }
        #filmstrip img:hover { opacity: 1; transform: translateY(-2px); }
        #filmstrip img.active { border-color: var(--gold); opacity: 1; }
        #filmstrip:empty { display: none; }
        #filmstrip .fs-empty { font-size: 11px; color: #a49b83; align-self: center;
            padding: 0 8px; white-space: nowrap; letter-spacing: .04em; }

        /* ---- Lightbox 導覽鈕 ---- */
        .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
            width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
            border: none; background: rgba(255,253,247,.14); color: #f5efe0;
            font-size: 24px; line-height: 1; display: flex; align-items: center;
            justify-content: center; transition: background .15s; }
        .lb-nav:hover { background: rgba(255,253,247,.32); }
        .lb-prev { left: 18px; }
        .lb-next { right: 18px; }

        /* ================= 工作台入口頁（合併自 workbench.html） ================= */
        #workbench { position: fixed; inset: 0; z-index: 10000; background: #14181f; overflow: hidden; }
        #workbench.hidden { display: none; }
        /* 板塊 hover 放大效果：滑鼠移上去該板塊輕微放大（牆面地板不動） */
        #workbench .scene { position: absolute; inset: 0; overflow: hidden; }
        #workbench .scene svg { width: 100%; height: 100%; display: block; }
        #workbench .fx { transform-box: fill-box; transform-origin: 50% 50%;
            transition: transform .35s cubic-bezier(.2,.8,.3,1.15);
            will-change: transform; }
        #workbench .fx:hover { transform: scale(1.05); }
        /* 書桌面積大，放大幅度小一點 */
        #workbench #deskHotspot.fx:hover { transform: scale(1.02); }
        #workbench .desk-hotspot { cursor: pointer; }
        #workbench .desk-hotspot:hover .desk-top { fill: #8a6746; }
        #workbench .desk-hotspot:active { filter: brightness(1.07); }
        #workbench .glow { animation: flicker 5s ease-in-out infinite; }
        @keyframes flicker { 0%,100% { opacity: .85; } 45% { opacity: 1; } 60% { opacity: .78; } }
        #workbench #hint { position: fixed; left: 50%; bottom: 34px; transform: translateX(-50%);
            color: rgba(240,232,210,.85); font-size: 14px; letter-spacing: .18em;
            text-shadow: 0 2px 8px rgba(0,0,0,.8); animation: bob 2.4s ease-in-out infinite;
            pointer-events: none; z-index: 5; }
        @keyframes bob { 0%,100% { transform: translateX(-50%) translateY(0); opacity: .8; }
            50% { transform: translateX(-50%) translateY(-6px); opacity: 1; } }
        #workbench .tree-poster { cursor: default; transition: filter .3s; }
        #workbench .tree-poster:hover { filter: brightness(1.12); }
        #workbench #bookWrap { position: fixed; inset: 0; z-index: 20; display: none;
            align-items: center; justify-content: center;
            background: rgba(8, 10, 15, .82);
            backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
        #workbench #bookWrap.open { display: flex; }
        #workbench .book-stage { position: relative;
            /* 書本跟隨滑鼠傾斜（由 JS 寫入 --bry/--brx） */
            transform: scale(var(--bs, 1)) rotateX(var(--brx, 0deg)) rotateY(var(--bry, 0deg));
            transform-style: preserve-3d; will-change: transform; }
        #workbench #bookWrap.open .book-stage { animation: bookIn .5s cubic-bezier(.2,.85,.3,1.15); }
        @keyframes bookIn {
            from { transform: scale(calc(var(--bs, 1) * .88)) rotateX(10deg) rotateY(0deg); opacity: 0; }
            to   { opacity: 1; } }
        #workbench #book { position: relative; width: 680px; height: 460px;
            transform-style: preserve-3d; perspective: 2200px; }
        #workbench #book::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 50%;
            background: linear-gradient(150deg, #3a2a1b, #2b1f12);
            border-radius: 12px 4px 4px 12px; border: 1px solid #241a10;
            box-shadow: 0 24px 60px rgba(0,0,0,.6); }
        #workbench .sheet { position: absolute; top: 0; bottom: 0; left: 50%; width: 50%;
            transform-origin: left center; transform-style: preserve-3d;
            transition: transform 1s cubic-bezier(.35,.1,.2,1); }
        #workbench .sheet.flipped { transform: rotateY(-180deg); }
        #workbench .face { position: absolute; inset: 0; backface-visibility: hidden;
            -webkit-backface-visibility: hidden; border-radius: 4px 12px 12px 4px;
            overflow: hidden;
            /* 部分引擎不支援 backface-visibility，兩面可見度另由 JS 依翻頁狀態切換 */
            transition: opacity 1s cubic-bezier(.35,.1,.2,1), visibility 1s; }
        #workbench .face.back { transform: rotateY(180deg); border-radius: 12px 4px 4px 12px; }
        #workbench .cover { background: linear-gradient(150deg, #4a3524, #2f2214);
            border: 1px solid #241a10; box-shadow: 0 24px 60px rgba(0,0,0,.6);
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            color: #d9b96a; }
        #workbench .cover::before { content: ""; position: absolute; inset: 16px;
            border: 2px solid rgba(217,185,106,.5); border-radius: 3px 9px 9px 3px; }
        #workbench .cover .emboss { font-family: var(--serif); font-size: 34px; letter-spacing: .3em;
            text-indent: .3em; font-weight: 700;
            text-shadow: 0 1px 0 rgba(0,0,0,.6), 0 -1px 0 rgba(255,255,255,.08); }
        #workbench .cover .sub { margin-top: 14px; font-size: 12px; letter-spacing: .4em; text-indent: .4em;
            color: #a58a4e; }
        #workbench .cover .open-tip { margin-top: 46px; font-size: 12px; color: #8d7440;
            animation: bob 2s ease-in-out infinite; }
        #workbench .paper { background: linear-gradient(120deg, #f4ecd8, #ece1c6);
            color: #4c4230; box-shadow: 0 24px 60px rgba(0,0,0,.6); padding: 22px 22px; }
        #workbench .paper h3 { font-family: var(--serif); font-size: 16px;
            letter-spacing: .2em; margin-bottom: 14px; color: #5c4a2e;
            border-bottom: 1px solid #cbb98d; padding-bottom: 8px; }
        #workbench .paper p { font-size: 12px; line-height: 1.85; color: #6b5d42; }
        #workbench .paper .note { margin-top: 12px; font-size: 11px; color: #99865e; font-style: italic; }
        #workbench .folders { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }
        #workbench .folder { cursor: pointer; position: relative;
            transition: transform .18s cubic-bezier(.2,.8,.3,1.25); }
        #workbench .folder:hover { transform: translateY(-3px); }
        #workbench .folder:active { transform: translateY(-1px) scale(.985); }
        #workbench .folder .ftab { position: absolute; top: -11px; left: 14px; background: #c9a86a;
            color: #5c4a2e; font-size: 10.5px; font-weight: 700; padding: 3px 10px 2px;
            border-radius: 5px 5px 0 0; letter-spacing: .04em;
            box-shadow: 0 -1px 3px rgba(0,0,0,.15); }
        #workbench .folder .fbody { background: linear-gradient(160deg, #d9bd85, #c7a767);
            border-radius: 3px 6px 6px 6px; padding: 12px 14px; min-height: 64px;
            box-shadow: 0 6px 14px rgba(60,40,10,.25), inset 0 0 0 1px rgba(255,255,255,.25);
            display: flex; align-items: center; gap: 10px; }
        #workbench .folder .flabel { font-size: 13px; font-weight: 700; color: #5c4a2e; line-height: 1.45; }
        #workbench .folder .flabel small { display: block; font-weight: 400; font-size: 10px;
            color: #8a744c; margin-top: 3px; letter-spacing: .02em; }
        #workbench .folder .stamp { margin-left: auto; flex: none; font-size: 10px; padding: 3px 10px;
            border-radius: 99px; letter-spacing: .06em; white-space: nowrap; }
        #workbench .folder.locked .fbody { filter: saturate(.45) brightness(.94); }
        #workbench .folder.locked .stamp { background: #6d6555; color: #e8e2d2; }
        #workbench .folder.locked .ftab { background: #b09a72; color: #6d5c3d; }
        #workbench .folder.open-able .stamp { background: var(--accent); color: #fff; font-weight: 700;
            animation: pulse 1.8s ease-in-out infinite; }
        #workbench .folder.open-able .ftab { background: var(--accent); color: #f5e8c8; }
        @keyframes pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(166,61,47,.5); }
            50% { box-shadow: 0 0 0 6px rgba(166,61,47,0); } }
        #workbench .folder.shake { animation: shake .4s; }
        @keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); } 75% { transform: translateX(-3px); } }
        /* 書脊陰影：貼齊書本中縫（正面紙在左緣、翻面後背面紙的書脊在右緣），
           舊版 left:50% 會讓陰影跑到每頁正中間，看起來像一條黑線橫穿檔案夾 */
        #workbench .gutter { position: absolute; top: 0; bottom: 0; width: 34px;
            pointer-events: none; }
        #workbench .face:not(.back) .gutter {
            left: 0; background: linear-gradient(90deg, rgba(50,38,18,.22), rgba(0,0,0,0)); }
        #workbench .face.back .gutter {
            right: 0; background: linear-gradient(270deg, rgba(50,38,18,.22), rgba(0,0,0,0)); }
        #workbench .book-nav { margin-top: 18px; display: flex; align-items: center;
            justify-content: center; gap: 14px; }
        #workbench .book-nav button { width: 38px; height: 38px; padding: 0; border-radius: 50%;
            border: 1px solid #5c4a2e; background: rgba(244,236,216,.1); color: #d9b96a;
            font-size: 18px; cursor: pointer; transition: transform .12s, background .15s, color .15s; }
        #workbench .book-nav button:active { transform: scale(.85); }
        #workbench .book-nav button:hover { background: rgba(244,236,216,.1);
            border-color: #5c4a2e; color: #d9b96a; }
        #workbench .book-nav button:disabled { opacity: .25; cursor: default; }
        #workbench .book-nav span { color: #a58a4e; font-size: 12px; letter-spacing: .1em; }
        #workbench #bookClose { position: fixed; top: 22px; right: 26px; z-index: 30; width: 40px;
            height: 40px; padding: 0; border-radius: 50%; border: 1px solid rgba(217,185,106,.4);
            background: transparent; color: #d9b96a; font-size: 17px; cursor: pointer; }
        #workbench #bookClose:hover { background: rgba(217,185,106,.15);
            border-color: rgba(217,185,106,.4); color: #d9b96a; }
        #workbench #toast { position: fixed; left: 50%; bottom: 46px;
            transform: translateX(-50%) translateY(20px);
            background: rgba(30,26,18,.92); color: #e8dfc8; font-size: 12.5px; letter-spacing: .06em;
            padding: 9px 18px; border-radius: 99px; border: 1px solid rgba(217,185,106,.35);
            opacity: 0; pointer-events: none; transition: all .25s; z-index: 40; }
        #workbench #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        #workbench #wbFade { position: fixed; inset: 0; background: #000; opacity: 0;
            pointer-events: none; transition: opacity .7s; z-index: 50; }
        #workbench #wbFade.on { opacity: 1; pointer-events: all; }

        /* ---- Leaflet 控制項（做舊紙感） ---- */
        .leaflet-control-layers { max-height: 70vh; overflow-y: auto;
            border-radius: 8px !important; box-shadow: 0 3px 12px rgba(70,55,30,.25) !important;
            font-size: 12px; border: 1px solid var(--line) !important;
            background: var(--card); color: #5a5240; }
        .leaflet-control-layers-expanded { background: var(--card); color: #5a5240; }
        .leaflet-bar a { border-radius: 0 !important;
            background: var(--card) !important; color: #8a6a3a !important;
            border-bottom: 1px solid var(--line) !important; }
        .leaflet-bar a:hover { background: var(--card2) !important; }
        .leaflet-control-attribution { background: rgba(248,243,229,.85) !important;
            color: #9a8f74 !important; font-size: 9.5px !important; }
        .leaflet-control-attribution a { color: var(--accent) !important; }
        /* 圖層面板改為純點擊開合（Leaflet 預設 hover 展開/滑走收合+圖示消失，容易讓人以為按鈕壞掉） */
        .leaflet-control-layers .leaflet-control-layers-list { display: none; }
        .leaflet-control-layers.layers-open .leaflet-control-layers-list { display: block; }
        .leaflet-control-layers-expanded .leaflet-control-layers-toggle { display: block; }
        .leaflet-bar a { border-radius: 0 !important; }
        .leaflet-container { font-family: inherit; }
        /* 返回工作台 */
        #backHome { position: absolute; top: 10px; left: 52px; z-index: 1100;
            width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
            background: var(--card); border: 1px solid var(--line); border-radius: 4px;
            color: var(--accent); font-size: 15px; text-decoration: none; cursor: pointer;
            box-shadow: 0 1px 5px rgba(50,40,20,.25); transition: background .15s; }
        #backHome:hover { background: var(--accent); color: #fff; }
        /* 地圖入口提示：地圖是探索檔案的入口，點選後在右欄閱讀照片 */
        #mapHint { position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
            z-index: 900; pointer-events: none; white-space: nowrap;
            background: rgba(250,246,234,.94); border: 1px solid var(--line);
            border-radius: 99px; padding: 6px 16px;
            font-size: 11.5px; color: #6e6752; letter-spacing: .06em;
            box-shadow: 0 2px 10px rgba(70,55,30,.18); }
        #mapHint b { color: var(--accent); font-weight: 700; }
        /* 選中第一張照片後提示自動淡出（任務已完成，讓出畫面） */
        #mapHint { transition: opacity .9s; }
        #mapHint.gone { opacity: 0; }

        /* ---- 窄桌面：照片欄略收，避免地圖被擠得太小 ---- */
        @media (max-width: 1340px) and (min-width: 1101px) {
            .app { grid-template-columns: 250px 1fr 440px; }
            .col-detail { padding: 18px 20px 24px; }
        }
        /* ---- 平板 ---- */
        @media (max-width: 1100px) {
            .app { grid-template-columns: 240px 1fr; grid-template-rows: 1fr 320px;
                grid-template-areas: "filters map" "detail detail"; }
            .col-detail { border-left: none; border-top: 1px solid var(--line); }
            /* 版式改為上下疊時，撕紙邊方向不對，隱藏 */
            .col-detail::after { display: none; }
        }
        /* ---- 手機 ---- */
        @media (max-width: 700px) {
            .app { display: flex; flex-direction: column; height: auto; min-height: 100vh; }
            .col-filters { order: 2; border-right: none; border-top: 1px solid var(--line); max-height: none; }
            .col-map { order: 1; height: 55vh; }
            .col-detail { order: 3; border-top: 1px solid var(--line); }
            /* 手機上地圖小，入口提示膠囊只佔位不提供資訊，隱藏 */
            #mapHint { display: none; }
        }
    </style>
