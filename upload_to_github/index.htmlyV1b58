            <text x="1031" y="122" text-anchor="middle" font-size="14" fill="#6b5a34"
                font-family="Songti TC, serif" letter-spacing="4">家 戶 譜 系</text>
            <text x="1031" y="138" text-anchor="middle" font-size="8" fill="#98875e">馬灣涌 · Ma Wan Chung</text>
            <g stroke="#8a744c" stroke-width="1.2" fill="none">
                <line x1="1031" y1="152" x2="1031" y2="166"/>
                <line x1="963" y1="166" x2="1099" y2="166"/>
                <line x1="963" y1="166" x2="963" y2="180"/><line x1="1099" y1="166" x2="1099" y2="180"/>
                <line x1="963" y1="222" x2="963" y2="240"/><line x1="1099" y1="222" x2="1099" y2="240"/>
                <line x1="997" y1="240" x2="1065" y2="240"/>
                <line x1="997" y1="240" x2="997" y2="254"/><line x1="1065" y1="240" x2="1065" y2="254"/>
            </g>
            <g fill="#e9e2cc" stroke="#a5946a" stroke-width="1.2">
                <rect x="948" y="180" width="30" height="42" rx="2"/>
                <rect x="1084" y="180" width="30" height="42" rx="2"/>
                <rect x="982" y="254" width="30" height="42" rx="2"/>
                <rect x="1050" y="254" width="30" height="42" rx="2"/>
                <rect x="1016" y="300" width="30" height="42" rx="2"/>
            </g>
            <g fill="#98875e" font-size="7.5" text-anchor="middle">
                <text x="963" y="198">張</text><text x="1099" y="198">陳</text>
                <text x="997" y="272">黃</text><text x="1065" y="272">李</text>
                <text x="1031" y="318">蘇</text>
            </g>
            <g stroke="#b3a67f" stroke-width="1" opacity=".8">
                <line x1="930" y1="356" x2="1132" y2="356"/>
                <text x="1031" y="372" text-anchor="middle" font-size="7" fill="#98875e"
                    stroke="none">1992 田野記錄 · 未完待考</text>
            </g>
            <circle cx="920" cy="92" r="4" fill="#c0392b"/><circle cx="1142" cy="92" r="4" fill="#c0392b"/>
        </g>
        <!-- 燈與光暈（視差板塊） -->
        <g class="fx" data-d="5">
            <line x1="600" y1="0" x2="600" y2="36" stroke="#3a4358" stroke-width="3"/>
            <path d="M580 36 L620 36 L612 52 L588 52 Z" fill="#3a4358"/>
            <ellipse cx="600" cy="56" rx="26" ry="8" fill="#ffe9b0"/>
            <ellipse class="glow" cx="600" cy="70" rx="200" ry="120" fill="url(#lampGlow)"/>
        </g>
        <!-- 懶人沙發（視差板塊） -->
        <g class="fx" data-d="12">
        <ellipse cx="470" cy="430" rx="58" ry="26" fill="#26304a"/>
        <ellipse cx="470" cy="420" rx="52" ry="24" fill="#2e3a58"/>
        </g>
        <!-- 工作台（可點；視差板塊） -->
        <g class="desk-hotspot fx" id="deskHotspot" data-d="14">
            <ellipse cx="600" cy="70" rx="160" ry="90" fill="url(#lampGlow)" opacity=".5"/>
            <polygon class="desk-top" points="300,430 880,430 920,470 260,470" fill="#7a5a3a"/>
            <polygon points="260,470 920,470 920,486 260,486" fill="#5d4128"/>
            <rect x="300" y="486" width="270" height="150" fill="#6b4c2e"/>
            <rect x="312" y="500" width="246" height="34" rx="3" fill="#7d5a36"/>
            <rect x="312" y="544" width="246" height="34" rx="3" fill="#7d5a36"/>
            <rect x="312" y="588" width="246" height="34" rx="3" fill="#7d5a36"/>
            <g fill="#caa25e"><rect x="425" y="513" width="20" height="6" rx="3"/>
                <rect x="425" y="557" width="20" height="6" rx="3"/><rect x="425" y="601" width="20" height="6" rx="3"/></g>
            <rect x="610" y="486" width="270" height="150" fill="#6b4c2e"/>
            <rect x="622" y="500" width="246" height="70" rx="3" fill="#7d5a36"/>
            <rect x="622" y="582" width="246" height="56" rx="3" fill="#7d5a36"/>
            <rect x="735" y="530" width="20" height="6" rx="3" fill="#caa25e"/>
            <g>
                <rect x="700" y="382" width="120" height="48" rx="4" fill="#3f4c66"/>
