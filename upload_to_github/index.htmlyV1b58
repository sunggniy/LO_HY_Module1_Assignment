<!-- ================= 田野工作台入口場景 ================= -->
<div id="workbench">
    <div class="scene">
    <svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice">
        <defs>
            <linearGradient id="wall" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#232a3e"/><stop offset="1" stop-color="#1a2030"/>
            </linearGradient>
            <linearGradient id="floor" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#5d442c"/><stop offset="1" stop-color="#3e2d1c"/>
            </linearGradient>
            <radialGradient id="lampGlow" cx=".5" cy=".5" r=".5">
                <stop offset="0" stop-color="#ffd98a" stop-opacity=".55"/>
                <stop offset="1" stop-color="#ffd98a" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="roomVign" cx=".5" cy=".45" r=".75">
                <stop offset=".55" stop-color="#000" stop-opacity="0"/>
                <stop offset="1" stop-color="#000" stop-opacity=".55"/>
            </radialGradient>
        </defs>
        <!-- 牆與地板 -->
        <rect x="0" y="0" width="1200" height="460" fill="url(#wall)"/>
        <rect x="0" y="460" width="1200" height="240" fill="url(#floor)"/>
        <g stroke="#2f2213" stroke-width="2" opacity=".5">
            <line x1="0" y1="510" x2="1200" y2="510"/><line x1="0" y1="565" x2="1200" y2="565"/>
            <line x1="0" y1="625" x2="1200" y2="625"/>
            <line x1="180" y1="460" x2="120" y2="700"/><line x1="420" y1="460" x2="390" y2="700"/>
            <line x1="660" y1="460" x2="660" y2="700"/><line x1="900" y1="460" x2="930" y2="700"/>
            <line x1="1080" y1="460" x2="1140" y2="700"/>
        </g>
        <!-- 地毯（視差板塊） -->
        <g class="fx" data-d="10">
        <ellipse cx="720" cy="580" rx="280" ry="72" fill="#6e3a3a" opacity=".85"/>
        <ellipse cx="720" cy="580" rx="240" ry="58" fill="none" stroke="#8a5252" stroke-width="3" opacity=".7"/>
        </g>
        <!-- 窗與掛鐘（視差板塊） -->
        <g class="fx" data-d="6">
        <rect x="690" y="110" width="150" height="170" rx="4" fill="#101722" stroke="#3a4358" stroke-width="4"/>
        <g stroke="#3a4358" stroke-width="3"><line x1="765" y1="110" x2="765" y2="280"/><line x1="690" y1="195" x2="840" y2="195"/></g>
        <circle cx="815" cy="145" r="13" fill="#d8dce8" opacity=".8"/>
        <!-- 掛鐘 -->
        <circle cx="628" cy="92" r="24" fill="#20283a" stroke="#8b93a8" stroke-width="3"/>
        <line x1="628" y1="92" x2="628" y2="76" stroke="#c9cedd" stroke-width="2"/>
        <line x1="628" y1="92" x2="640" y2="96" stroke="#c9cedd" stroke-width="2"/>
        </g>
        <!-- 軟木板（左，釘上田野照片與筆記；視差板塊） -->
        <g class="fx" data-d="7">
        <rect x="86" y="112" width="352" height="212" rx="6" fill="#9a7344" stroke="#6b4c28" stroke-width="7"/>
        <rect x="98" y="124" width="328" height="188" fill="#b28a55"/>
        <g transform="rotate(-2 150 190)">
            <rect x="112" y="146" width="86" height="70" fill="#f4efdf" stroke="#d8d0b8"/>
